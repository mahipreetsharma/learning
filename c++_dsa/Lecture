What Access Specifiers Control
Access specifiers determine who can see and use a class member (variable or function). They are the primary mechanism for encapsulation in C++.

cpp
class MyClass {
public:      // Anyone can access
    int publicVar;
    
private:     // Only this class can access
    int privateVar;
    
protected:   // This class and derived classes can access
    int protectedVar;
};
1.1 Public – No Restrictions
Public members are accessible from anywhere the object is visible.

cpp
#include <iostream>
using namespace std;

class PublicExample {
public:
    int data;
    
    void show() {
        cout << "Public function called" << endl;
    }
};

int main() {
    PublicExample obj;
    
    // Direct access from main()
    obj.data = 42;           // OK
    obj.show();              // OK
    
    cout << obj.data << endl;  // 42
    
    return 0;
}
When to use public: Functions that form the interface of the class. Member variables should almost never be public.

1.2 Private – Class-Only Access
Private members can only be accessed by member functions of the same class. Not even derived classes can access private members.

cpp
#include <iostream>
using namespace std;

class PrivateExample {
private:
    int secretNumber;
    string password;
    
    void internalHelper() {
        cout << "Helper function called" << endl;
    }
    
public:
    PrivateExample() : secretNumber(0), password("default") {}
    
    void setSecret(int value) {
        secretNumber = value;     // OK - inside class
        internalHelper();          // OK - inside class
    }
    
    int getSecret() {
        return secretNumber;       // OK - inside class
    }
    
    void setPassword(string pwd) {
        if (pwd.length() >= 8) {   // Validation possible!
            password = pwd;
        } else {
            cout << "Password too short!" << endl;
        }
    }
};

int main() {
    PrivateExample obj;
    
    obj.setSecret(100);           // OK - public interface
    cout << obj.getSecret() << endl;  // 100
    
    // obj.secretNumber = 200;    // ERROR - private
    // obj.internalHelper();       // ERROR - private
    
    obj.setPassword("secure123");  // OK - validation applied
    // obj.password = "123";       // ERROR - private
    
    return 0;
}
Key rule: Private = only within the class body. Not even child classes can access.

cpp
class Parent {
private:
    int parentPrivate = 10;
    
public:
    int parentPublic = 20;
};

class Child : public Parent {
public:
    void tryAccess() {
        // parentPrivate = 30;   // ERROR - private in parent
        parentPublic = 40;        // OK - public is accessible
    }
};
1.3 Protected – Class and Derived Classes
Protected members are accessible in the base class and derived classes, but not outside.

cpp
#include <iostream>
using namespace std;

class Animal {
protected:
    int age;
    string name;
    
public:
    Animal(string n, int a) : name(n), age(a) {}
    
    void breathe() {
        cout << name << " is breathing" << endl;
    }
};

class Dog : public Animal {
private:
    string breed;
    
public:
    Dog(string n, int a, string b) : Animal(n, a), breed(b) {}
    
    void display() {
        // Protected members accessible in derived class
        cout << "Name: " << name << endl;     // OK - protected
        cout << "Age: " << age << endl;       // OK - protected
        cout << "Breed: " << breed << endl;
        
        // Can modify protected members
        age = age + 1;     // OK - derived class can modify
    }
};

int main() {
    Dog fido("Fido", 3, "Golden");
    fido.breathe();        // OK - public
    fido.display();        // OK - public
    
    // fido.name = "Rex";  // ERROR - protected (not accessible outside)
    // fido.age = 5;       // ERROR - protected
    
    return 0;
}
1.4 Access Specifier Comparison Table
Access	Inside Class	Inside Derived Class	Outside Class
public	✅ Yes	✅ Yes	✅ Yes
protected	✅ Yes	✅ Yes	❌ No
private	✅ Yes	❌ No	❌ No
1.5 Default Access (If No Specifier Given)
In a class, members are private by default.

cpp
class DefaultClass {
    int x;           // private by default
    void func() {}   // private by default
    
public:
    int y;           // explicitly public
};
In a struct, members are public by default.

cpp
struct DefaultStruct {
    int x;           // public by default
    void func() {}   // public by default
};
Best practice: Always explicitly specify access. Do not rely on defaults.

1.6 Multiple Access Specifiers
A class can have multiple public:, private:, and protected: sections in any order.

cpp
class Example {
private:
    int a;
    
public:
    void setA(int val) { a = val; }
    
private:
    int b;           // Another private section
    
public:
    void setB(int val) { b = val; }
    
protected:
    int c;
};
1.7 Access Specifiers in Inheritance
When a class inherits, the access specifier in the inheritance list determines how inherited members are transformed.

cpp
#include <iostream>
using namespace std;

class Base {
public:
    int pub = 1;
protected:
    int prot = 2;
private:
    int priv = 3;
};

// PUBLIC INHERITANCE - preserves original access levels
class PubDerived : public Base {
    // pub remains public
    // prot remains protected
    // priv is inaccessible
};

// PROTECTED INHERITANCE - public becomes protected, protected remains protected
class ProtDerived : protected Base {
    // pub becomes protected
    // prot remains protected
    // priv is inaccessible
};

// PRIVATE INHERITANCE - everything becomes private
class PrivDerived : private Base {
    // pub becomes private
    // prot becomes private
    // priv is inaccessible
};

int main() {
    PubDerived pubObj;
    pubObj.pub = 10;     // OK - public
    
    ProtDerived protObj;
    // protObj.pub = 10; // ERROR - now protected
    
    PrivDerived privObj;
    // privObj.pub = 10; // ERROR - now private
    
    return 0;
}
1.8 Friend Functions and Classes – Breaking the Rules
friend allows external functions or classes to access private and protected members.

cpp
#include <iostream>
using namespace std;

class BankAccount {
private:
    double balance;
    string pin;
    
public:
    BankAccount(double initial, string p) : balance(initial), pin(p) {}
    
    // Declare a non-member function as friend
    friend void inspectAccount(const BankAccount& acc);
    
    // Declare another class as friend
    friend class Auditor;
};

// Friend function can access private members
void inspectAccount(const BankAccount& acc) {
    cout << "Balance: " << acc.balance << endl;     // OK - friend
    cout << "PIN hash: " << acc.pin << endl;        // OK - friend
}

class Auditor {
public:
    void audit(const BankAccount& acc) {
        cout << "Auditing balance: " << acc.balance << endl;
        // Can access private members
    }
};

int main() {
    BankAccount acc(5000, "1234");
    inspectAccount(acc);   // Friend function
    Auditor a;
    a.audit(acc);          // Friend class
    
    // acc.balance = 1000; // ERROR - still private to non-friends
    
    return 0;
}
When to use friend:

Operator overloading (<<, >>) – see later

Two classes that are tightly coupled (Container and Iterator)

Testing frameworks

When NOT to use friend:

To avoid writing getters/setters (bad design)

When the called function could be a member instead

1.9 Edge Cases and Common Pitfalls
Edge Case 1: Accessing Private Members Through Public Functions
cpp
class DataHolder {
private:
    int secret = 100;
    
public:
    int* getSecretPointer() {
        return &secret;   // DANGEROUS - exposes private address
    }
    
    const int& getSecretReference() const {
        return secret;    // Read-only access - safer but still exposes
    }
};

int main() {
    DataHolder dh;
    int* ptr = dh.getSecretPointer();
    *ptr = 999;           // Modifies private member via pointer!
    // This bypasses encapsulation entirely. Don't do this.
    
    return 0;
}
Edge Case 2: Member Functions Can Access Private Members of Any Object of Same Class
cpp
class Equalable {
private:
    int value;
    
public:
    Equalable(int v) : value(v) {}
    
    bool isEqual(const Equalable& other) const {
        // Can access other's private member!
        return this->value == other.value;
    }
};

int main() {
    Equalable a(10), b(10), c(20);
    cout << a.isEqual(b) << endl;  // 1 (true)
    cout << a.isEqual(c) << endl;  // 0 (false)
    return 0;
}
Edge Case 3: Static Members Have Same Access Rules
cpp
class Counter {
private:
    static int count;    // Private static member
    
public:
    Counter() { count++; }
    static int getCount() { return count; }
};

int Counter::count = 0;  // Definition – OK, but still private

int main() {
    Counter c1, c2;
    cout << Counter::getCount() << endl;  // 2
    // cout << Counter::count << endl;    // ERROR - private
    return 0;
}
Edge Case 4: Access Specifiers Apply to Nested Classes
cpp
class Outer {
private:
    int outerData = 10;
    
public:
    class PublicInner {
    public:
        void show() { cout << "Public inner" << endl; }
    };
    
private:
    class PrivateInner {
    public:
        void show() { cout << "Private inner" << endl; }
    };
    
public:
    void usePrivateInner() {
        PrivateInner pi;
        pi.show();    // OK - Outer can access its private nested class
    }
};

int main() {
    Outer::PublicInner pub;
    pub.show();           // OK
    
    // Outer::PrivateInner priv;  // ERROR - PrivateInner is private
    Outer o;
    o.usePrivateInner();  // Works through public interface
    
    return 0;
}
1.10 Access Specifiers Summary Table
Situation	public	protected	private
Access from outside class	✅	❌	❌
Access from derived class	✅	✅	❌
Can be changed by inheritance?	Can become protected/private	Remains protected/becomes private	Never accessible
Typical use	Interface methods	For derived class extension	Internal data, helper methods
Part 2: The Four Pillars of OOP – Brief Introduction
What Are the Four Pillars?
Pillar	One-Sentence Definition
Encapsulation	Bundling data with methods that operate on that data, and hiding internal details from outside access
Abstraction	Showing only essential features while hiding complex implementation details
Inheritance	Creating new classes that acquire properties and behaviors from existing classes
Polymorphism	The same function call producing different behaviors depending on the actual object type
Brief Explanation of Each Pillar
Encapsulation (Brief)
What: Hide internal state, expose controlled interface

How in C++: private/protected members + public getters/setters

Why: Prevents invalid states, reduces coupling, enables maintenance

Abstraction (Brief)
What: Simplify complex reality by modeling classes appropriate to the problem

How in C++: Abstract classes with pure virtual functions

Why: Reduces complexity, allows focusing on what rather than how

Inheritance (Brief)
What: Create a hierarchy where child classes reuse and extend parent classes

How in C++: class Derived : public Base

Why: Code reuse, establishes "is-a" relationships

Polymorphism (Brief)
What: Same interface, different implementations

How in C++: virtual functions, base class pointers/references

Why: Flexibility, extensibility, Open/Closed Principle

Detailed deep dive of each pillar begins after we establish inheritance foundation.

Part 3: Inheritance – Deep Dive (Prerequisite)
Inheritance is taught FIRST because later examples of Polymorphism and Abstraction require it.

3.1 Why Inheritance Exists
Without inheritance, similar classes repeat the same code.

cpp
// WITHOUT INHERITANCE - Code duplication
class Dog {
private:
    string name;
    int age;
public:
    void eat() { cout << name << " is eating" << endl; }
    void sleep() { cout << name << " is sleeping" << endl; }
    void bark() { cout << name << " barks" << endl; }
};

class Cat {
private:
    string name;
    int age;
public:
    void eat() { cout << name << " is eating" << endl; }
    void sleep() { cout << name << " is sleeping" << endl; }
    void meow() { cout << name << " meows" << endl; }
};
// eat() and sleep() are duplicated!
3.2 Basic Inheritance Syntax
cpp
#include <iostream>
#include <string>
using namespace std;

// Base class (parent)
class Animal {
protected:
    string name;
    int age;
    
public:
    Animal(string n, int a) : name(n), age(a) {}
    
    void eat() {
        cout << name << " is eating" << endl;
    }
    
    void sleep() {
        cout << name << " is sleeping" << endl;
    }
    
    void display() {
        cout << "Name: " << name << ", Age: " << age << endl;
    }
};

// Derived class (child)
class Dog : public Animal {
private:
    string breed;
    
public:
    Dog(string n, int a, string b) : Animal(n, a), breed(b) {}
    
    void bark() {
        cout << name << " says Woof!" << endl;
    }
    
    void showBreed() {
        cout << name << " is a " << breed << endl;
    }
};

// Another derived class
class Cat : public Animal {
public:
    Cat(string n, int a) : Animal(n, a) {}
    
    void meow() {
        cout << name << " says Meow!" << endl;
    }
};

int main() {
    Dog fido("Fido", 3, "Golden Retriever");
    Cat whiskers("Whiskers", 5);
    
    // Inherited from Animal
    fido.eat();          // Fido is eating
    fido.sleep();        // Fido is sleeping
    fido.display();      // Name: Fido, Age: 3
    
    // Dog-specific
    fido.bark();         // Fido says Woof!
    fido.showBreed();    // Fido is a Golden Retriever
    
    // Cat inherited + specific
    whiskers.eat();      // Whiskers is eating
    whiskers.meow();     // Whiskers says Meow!
    
    return 0;
}
3.3 The protected Access Specifier in Inheritance
cpp
class Base {
private:
    int privateVar = 1;     // Not accessible in derived class
    
protected:
    int protectedVar = 2;   // Accessible in derived class
    
public:
    int publicVar = 3;      // Accessible everywhere
};

class Derived : public Base {
public:
    void showAccess() {
        // cout << privateVar;   // ERROR - private in base
        cout << protectedVar;    // OK - protected
        cout << publicVar;       // OK - public
    }
};
3.4 Constructor and Destructor Order
cpp
#include <iostream>
using namespace std;

class Base {
public:
    Base() { cout << "Base constructor" << endl; }
    ~Base() { cout << "Base destructor" << endl; }
};

class Derived : public Base {
public:
    Derived() { cout << "Derived constructor" << endl; }
    ~Derived() { cout << "Derived destructor" << endl; }
};

int main() {
    cout << "Creating object:" << endl;
    Derived d;
    cout << "Destroying object:" << endl;
    return 0;
}
Output:

text
Creating object:
Base constructor
Derived constructor
Destroying object:
Derived destructor
Base destructor
Rule: Base class constructor runs first, then derived. Destruction is reverse order.

3.5 Types of Inheritance
cpp
// Single inheritance
class A {};
class B : public A {};

// Multilevel inheritance
class A {};
class B : public A {};
