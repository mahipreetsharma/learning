// Hierarchical inheritance
class A {};
class B : public A {};
class C : public A {};

// Multiple inheritance
class A {};
class B {};
class C : public A, public B {};
Part 4: Encapsulation – Deep Dive
4.1 What Encapsulation Really Means
Encapsulation has two distinct parts:

Bundling – Data and operations on that data are together in one unit (the class)

Hiding – Internal details are hidden from outside code

cpp
#include <iostream>
#include <string>
using namespace std;

class BankAccount {
private:
    // HIDDEN from outside
    string accountNumber;
    double balance;
    string pin;
    int failedAttempts;
    
    // Private helper - internal use only
    bool validatePin(string enteredPin) {
        return enteredPin == pin;
    }
    
    void logTransaction(string type, double amount) {
        cout << "[LOG] " << type << ": " << amount << ", Balance: " << balance << endl;
    }
    
public:
    // PUBLIC interface
    BankAccount(string accNo, string p, double initial)
        : accountNumber(accNo), pin(p), balance(initial), failedAttempts(0) {
        logTransaction("CREATED", initial);
    }
    
    bool withdraw(string enteredPin, double amount) {
        if (!validatePin(enteredPin)) {
            failedAttempts++;
            cout << "Invalid PIN. Attempt " << failedAttempts << endl;
            return false;
        }
        
        if (amount <= 0) {
            cout << "Amount must be positive" << endl;
            return false;
        }
        
        if (amount > balance) {
            cout << "Insufficient funds" << endl;
            return false;
        }
        
        balance -= amount;
        logTransaction("WITHDRAW", amount);
        return true;
    }
    
    void deposit(double amount) {
        if (amount <= 0) {
            cout << "Amount must be positive" << endl;
            return;
        }
        balance += amount;
        logTransaction("DEPOSIT", amount);
    }
    
    double getBalance(string enteredPin) {
        if (validatePin(enteredPin)) {
            return balance;
        }
        return -1;
    }
};

int main() {
    BankAccount acc("123456", "1234", 1000);
    
    acc.deposit(500);
    acc.withdraw("1234", 200);
    cout << "Balance: " << acc.getBalance("1234") << endl;
    
    // Cannot access private members:
    // acc.balance = 999999;     // ERROR
    // acc.pin = "0000";         // ERROR
    // acc.validatePin("1234");  // ERROR
    
    return 0;
}
4.2 Why Encapsulation Matters
Without Encapsulation	With Encapsulation
Any code can modify any variable	Only class controls its data
Invalid states common (negative balance)	Validation prevents invalid states
Changing internals breaks all callers	Internal changes don't affect callers
Debugging is hard (who changed value?)	Clear entry points for modification
No invariants can be maintained	Invariants (like balance >= 0) guaranteed
4.3 Getters and Setters Best Practices
cpp
class Product {
private:
    string name;
    double price;
    int quantity;
    
public:
    Product(string n, double p, int q) : name(n), price(p), quantity(q) {}
    
    // Getter - const, returns copy or const reference
    string getName() const { return name; }
    
    // Getter with computed value
    double getTotalValue() const { return price * quantity; }
    
    // Setter with validation
    void setPrice(double newPrice) {
        if (newPrice >= 0) {
            price = newPrice;
        } else {
            cout << "Price cannot be negative" << endl;
        }
    }
    
    // Setter with side effects
    void setQuantity(int newQuantity) {
        if (newQuantity >= 0) {
            quantity = newQuantity;
        } else {
            cout << "Quantity cannot be negative" << endl;
        }
    }
};
Part 5: Abstraction – Deep Dive
5.1 What Abstraction Means
Abstraction is showing only essential features while hiding implementation details.

Real-world analogy: A car's dashboard. The driver sees speedometer, fuel gauge, steering wheel. The complex engine, transmission, and electronics are hidden.

5.2 Abstract Classes and Pure Virtual Functions
A pure virtual function is declared with = 0. A class with at least one pure virtual function is abstract – cannot be instantiated.

cpp
#include <iostream>
#include <string>
#include <cmath>
using namespace std;

// ABSTRACT CLASS - defines WHAT not HOW
class Shape {
public:
    // Pure virtual functions - no implementation here
    virtual double area() const = 0;
    virtual double perimeter() const = 0;
    virtual string getName() const = 0;
    
    // Virtual destructor - essential for abstract base classes
    virtual ~Shape() {}
};

// CONCRETE CLASS - implements the abstraction
class Circle : public Shape {
private:
    double radius;
    
public:
    Circle(double r) : radius(r) {}
    
    double area() const override {
        return M_PI * radius * radius;
    }
    
    double perimeter() const override {
        return 2 * M_PI * radius;
    }
    
    string getName() const override {
        return "Circle";
    }
};

class Rectangle : public Shape {
private:
    double width, height;
    
public:
    Rectangle(double w, double h) : width(w), height(h) {}
    
    double area() const override {
        return width * height;
    }
    
    double perimeter() const override {
        return 2 * (width + height);
    }
    
    string getName() const override {
        return "Rectangle";
    }
};

int main() {
    // Shape s;                      // ERROR - cannot instantiate abstract class
    
    Circle c(5);
    Rectangle r(4, 6);
    
    cout << c.getName() << " area: " << c.area() << endl;      // Circle area: 78.5398
    cout << r.getName() << " area: " << r.area() << endl;      // Rectangle area: 24
    
    // Polymorphic behavior (requires inheritance - we have it)
    Shape* shapes[] = {&c, &r};
    for (int i = 0; i < 2; i++) {
        cout << shapes[i]->getName() << ": " << shapes[i]->area() << endl;
    }
    
    return 0;
}
5.3 Interface Segregation Principle
Small, focused abstract classes are better than large, monolithic ones.

cpp
// BAD - one huge abstract class
class Machine {
public:
    virtual void print() = 0;
    virtual void scan() = 0;
    virtual void fax() = 0;
    virtual ~Machine() {}
};

// A simple printer forced to implement scan and fax
class SimplePrinter : public Machine {
public:
    void print() override { cout << "Printing" << endl; }
    void scan() override { }  // Empty - not supported
    void fax() override { }   // Empty - not supported
};

// GOOD - segregated interfaces
class Printer {
public:
    virtual void print() = 0;
    virtual ~Printer() {}
};

class Scanner {
public:
    virtual void scan() = 0;
    virtual ~Scanner() {}
};

class GoodPrinter : public Printer {
public:
    void print() override { cout << "Printing" << endl; }
};
Part 6: Polymorphism – Deep Dive
6.1 What Polymorphism Means
Poly = many, Morph = forms. Same function call, different behaviors based on actual object type.

6.2 Virtual Functions – The Core of Runtime Polymorphism
cpp
#include <iostream>
using namespace std;

class Animal {
public:
    // Virtual function - can be overridden
    virtual void makeSound() const {
        cout << "Some generic animal sound" << endl;
    }
    
    // Non-virtual function
    void breathe() const {
        cout << "Breathing" << endl;
    }
    
    virtual ~Animal() {}
};

class Dog : public Animal {
public:
    void makeSound() const override {
        cout << "Woof! Woof!" << endl;
    }
};

class Cat : public Animal {
public:
    void makeSound() const override {
        cout << "Meow!" << endl;
    }
};

void describeAnimal(const Animal& a) {
    a.makeSound();  // Virtual - calls correct version
    a.breathe();    // Non-virtual - always calls Animal version
}

int main() {
    Dog d;
    Cat c;
    
    describeAnimal(d);  // Woof! Woof!\nBreathing
    describeAnimal(c);  // Meow!\nBreathing
    
    return 0;
}
6.3 How Virtual Functions Work (VTable)
When a class has virtual functions, the compiler creates a vtable (virtual table) – an array of function pointers.

text
Object memory layout with virtual functions:
+----------------+
| vptr --------->|----> [ &Dog::makeSound, &Dog::~Dog ]
+----------------+
| name           |
+----------------+
| age            |
+----------------+
6.4 The override Keyword (C++11)
cpp
class Base {
public:
    virtual void func1() {}
    virtual void func2() {}
};

class Derived : public Base {
public:
    void func1() override { }      // OK - correctly overrides
    // void func2(int x) override { }  // ERROR - no matching base function
    // void func3() override { }       // ERROR - no virtual func3 in base
};
6.5 Pure Virtual Functions and Abstract Classes
cpp
// Abstract class
class Drawable {
public:
    virtual void draw() = 0;      // Pure virtual
    virtual ~Drawable() {}
};

class Circle : public Drawable {
public:
    void draw() override {
        cout << "Drawing a circle" << endl;
    }
};

class Square : public Drawable {
public:
    void draw() override {
        cout << "Drawing a square" << endl;
    }
};

void render(Drawable& d) {
    d.draw();  // Polymorphic call
}
Part 7: Complete Integrated Examples
Example 1: Banking System (All Four Pillars)
cpp
#include <iostream>
#include <string>
#include <vector>
using namespace std;

// ============ ABSTRACTION ============
// Abstract class defines WHAT operations an account must support
class Account {
protected:
    string accountNumber;
    string holderName;
    double balance;
    
public:
    Account(string accNo, string name, double initial)
        : accountNumber(accNo), holderName(name), balance(initial) {}
    
    // Pure virtual functions - ABSTRACTION
    virtual void deposit(double amount) = 0;
    virtual bool withdraw(double amount) = 0;
    virtual double getBalance() const = 0;
    virtual string getAccountType() const = 0;
    virtual void calculateInterest() = 0;
    
    // Regular virtual function
    virtual void display() const {
        cout << "Account: " << accountNumber << endl;
        cout << "Holder: " << holderName << endl;
        cout << "Balance: $" << balance << endl;
    }
    
    virtual ~Account() {}
};

// ============ INHERITANCE ============
class SavingsAccount : public Account {
private:
    double interestRate;
    int withdrawalCount;
    static const int FREE_WITHDRAWALS = 3;
    static const double WITHDRAWAL_FEE;
    
public:
    SavingsAccount(string accNo, string name, double initial, double rate)
        : Account(accNo, name, initial), interestRate(rate), withdrawalCount(0) {}
    
    // ENCAPSULATION - method with validation
    void deposit(double amount) override {
        if (amount <= 0) {
            cout << "Deposit amount must be positive" << endl;
            return;
        }
        balance += amount;
        cout << "Deposited $" << amount << " to savings account" << endl;
    }
    
    bool withdraw(double amount) override {
        if (amount <= 0) {
            cout << "Withdrawal amount must be positive" << endl;
            return false;
        }
        
        double finalAmount = amount;
        withdrawalCount++;
        
        if (withdrawalCount > FREE_WITHDRAWALS) {
            finalAmount += WITHDRAWAL_FEE;
            cout << "Withdrawal fee of $" << WITHDRAWAL_FEE << " applied" << endl;
        }
        
        if (finalAmount > balance) {
            cout << "Insufficient funds" << endl;
            return false;
        }
        
        balance -= finalAmount;
        cout << "Withdrew $" << amount << " from savings account" << endl;
        return true;
    }
    
    double getBalance() const override {
        return balance;
    }
    
    string getAccountType() const override {
        return "Savings";
    }
    
    void calculateInterest() override {
        double interest = balance * interestRate / 100;
        balance += interest;
        cout << "Interest of $" << interest << " added to savings account" << endl;
    }
    
    void display() const override {
        Account::display();
        cout << "Type: Savings, Rate: " << interestRate << "%, Free withdrawals left: "
             << (FREE_WITHDRAWALS - withdrawalCount) << endl;
    }
};

const double SavingsAccount::WITHDRAWAL_FEE = 2.0;

class CurrentAccount : public Account {
private:
    double overdraftLimit;
    
public:
    CurrentAccount(string accNo, string name, double initial, double overdraft)
        : Account(accNo, name, initial), overdraftLimit(overdraft) {}
    
