5 LeetCode Medium Questions (Looping Focus)
Question 1: Container With Most Water
LeetCode 11 | Difficulty: Medium

Problem Statement
Given an integer array height of length n. Find two lines that together with the x-axis form a container that holds the most water. Return maximum amount of water.

Example Cases

Input	Output	Explanation
[1,8,6,2,5,4,8,3,7]	49	Between indices 1 (8) and 8 (7): min(8,7) × 7 = 49
[1,1]	1	min(1,1) × 1 = 1
Constraints

2 ≤ n ≤ 10⁵

0 ≤ height[i] ≤ 10⁴

Solution – Brute Force
cpp
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int maxAreaBrute(vector<int>& height) {
    int n = height.size();
    int maxWater = 0;
    
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            int water = min(height[i], height[j]) * (j - i);
            maxWater = max(maxWater, water);
        }
    }
    return maxWater;
}

int main() {
    vector<int> height = {1, 8, 6, 2, 5, 4, 8, 3, 7};
    cout << "Max water: " << maxAreaBrute(height) << endl;  // 49
    return 0;
}
Time Complexity: O(n²)
Space Complexity: O(1)

Explanation: Check every possible pair of lines. For n=10⁵, this is ~5×10⁹ operations – too slow.

Solution – Optimized (Two Pointers)
cpp
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int maxArea(vector<int>& height) {
    int left = 0;
    int right = height.size() - 1;
    int maxWater = 0;
    
    while (left < right) {
        int currentWater = min(height[left], height[right]) * (right - left);
        maxWater = max(maxWater, currentWater);
        
        // Move the pointer pointing to the shorter line
        if (height[left] < height[right]) {
            left++;
        } else {
            right--;
        }
    }
    
    return maxWater;
}

int main() {
    vector<int> height = {1, 8, 6, 2, 5, 4, 8, 3, 7};
    cout << "Max water: " << maxArea(height) << endl;  // 49
    return 0;
}
Time Complexity: O(n) – single pass
Space Complexity: O(1)

Explanation of optimization: When height[left] < height[right], moving right inward decreases width and height (limited by left). Only moving the shorter pointer could increase area.

Question 2: 3Sum
LeetCode 15 | Difficulty: Medium

Problem Statement
Return all triplets [nums[i], nums[j], nums[k]] such that i != j != k and nums[i] + nums[j] + nums[k] == 0. No duplicate triplets.

Example Cases

Input	Output
[-1,0,1,2,-1,-4]	[[-1,-1,2],[-1,0,1]]
[0,1,1]	[]
Constraints

3 ≤ nums.length ≤ 3000

-10⁵ ≤ nums[i] ≤ 10⁵

Solution – Brute Force
cpp
#include <iostream>
#include <vector>
#include <algorithm>
#include <set>
using namespace std;

vector<vector<int>> threeSumBrute(vector<int>& nums) {
    int n = nums.size();
    set<vector<int>> uniqueTriplets;
    
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            for (int k = j + 1; k < n; k++) {
                if (nums[i] + nums[j] + nums[k] == 0) {
                    vector<int> triplet = {nums[i], nums[j], nums[k]};
                    sort(triplet.begin(), triplet.end());
                    uniqueTriplets.insert(triplet);
                }
            }
        }
    }
    
    return vector<vector<int>>(uniqueTriplets.begin(), uniqueTriplets.end());
}

int main() {
    vector<int> nums = {-1, 0, 1, 2, -1, -4};
    auto result = threeSumBrute(nums);
    for (auto& t : result) {
        cout << "[" << t[0] << "," << t[1] << "," << t[2] << "] ";
    }
    return 0;
}
Time Complexity: O(n³)
Space Complexity: O(n) for set

Solution – Optimized (Sort + Two Pointers)
cpp
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

vector<vector<int>> threeSum(vector<int>& nums) {
    vector<vector<int>> result;
    int n = nums.size();
    
    sort(nums.begin(), nums.end());
    
    for (int i = 0; i < n - 2; i++) {
        // Skip duplicate i values
        if (i > 0 && nums[i] == nums[i - 1]) continue;
        
        int left = i + 1;
        int right = n - 1;
        
        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right];
            
            if (sum == 0) {
                result.push_back({nums[i], nums[left], nums[right]});
                
                // Skip duplicates
                while (left < right && nums[left] == nums[left + 1]) left++;
                while (left < right && nums[right] == nums[right - 1]) right--;
                
                left++;
                right--;
            } else if (sum < 0) {
                left++;
            } else {
                right--;
            }
        }
    }
    
    return result;
}

int main() {
    vector<int> nums = {-1, 0, 1, 2, -1, -4};
    auto result = threeSum(nums);
    for (auto& t : result) {
        cout << "[" << t[0] << "," << t[1] << "," << t[2] << "] ";
    }
    return 0;
}
Time Complexity: O(n²)
Space Complexity: O(1) excluding output

Explanation: Sort array first. Fix one element, then use two pointers to find pairs that sum to its negative. Skip duplicates to avoid repeating triplets.

Question 3: Subarray Sum Equals K
LeetCode 560 | Difficulty: Medium

Problem Statement
Given an array of integers nums and an integer k, return the total number of continuous subarrays whose sum equals k.

Example Cases

Input	Output	Explanation
[1,1,1], k=2	2	Subarrays: [1,1] at indices (0,1) and (1,2)
[1,2,3], k=3	2	Subarrays: [1,2] and [3]
Constraints

1 ≤ nums.length ≤ 2×10⁴

-1000 ≤ nums[i] ≤ 1000

-10⁷ ≤ k ≤ 10⁷

Solution – Brute Force
cpp
#include <iostream>
#include <vector>
using namespace std;

int subarraySumBrute(vector<int>& nums, int k) {
    int n = nums.size();
    int count = 0;
    
    for (int i = 0; i < n; i++) {
        int sum = 0;
        for (int j = i; j < n; j++) {
            sum += nums[j];
            if (sum == k) {
                count++;
            }
        }
    }
    
    return count;
}

int main() {
    vector<int> nums = {1, 1, 1};
    cout << subarraySumBrute(nums, 2) << endl;  // 2
    return 0;
}
Time Complexity: O(n²)
Space Complexity: O(1)

Solution – Optimized (Prefix Sum + Hash Map)
cpp
#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

int subarraySum(vector<int>& nums, int k) {
    unordered_map<int, int> prefixSumCount;
    prefixSumCount[0] = 1;  // Empty prefix sum
    
    int count = 0;
    int runningSum = 0;
    
    for (int num : nums) {
        runningSum += num;
        
        // If (runningSum - k) exists, then subarrays ending here sum to k
        if (prefixSumCount.find(runningSum - k) != prefixSumCount.end()) {
            count += prefixSumCount[runningSum - k];
        }
        
        prefixSumCount[runningSum]++;
    }
    
    return count;
}

int main() {
    vector<int> nums = {1, 2, 3};
    cout << subarraySum(nums, 3) << endl;  // 2
    
    vector<int> nums2 = {1, 1, 1};
    cout << subarraySum(nums2, 2) << endl;  // 2
    
    return 0;
}
Time Complexity: O(n)
Space Complexity: O(n)

Explanation: For each position, store cumulative sum. If currentSum - k was seen before, those subarrays sum to k. The hash map stores frequency of each prefix sum.

Question 4: Product of Array Except Self
LeetCode 238 | Difficulty: Medium

Problem Statement
Given an integer array nums, return an array answer such that answer[i] is equal to the product of all elements of nums except nums[i]. Without using division.

Example Cases

Input	Output
[1,2,3,4]	[24,12,8,6]
[-1,1,0,-3,3]	[0,0,9,0,0]
Constraints

2 ≤ nums.length ≤ 10⁵

-30 ≤ nums[i] ≤ 30

Solution – Brute Force
cpp
#include <iostream>
#include <vector>
using namespace std;

vector<int> productExceptSelfBrute(vector<int>& nums) {
    int n = nums.size();
    vector<int> result(n, 1);
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i != j) {
                result[i] *= nums[j];
            }
        }
    }
    
    return result;
}

int main() {
    vector<int> nums = {1, 2, 3, 4};
    auto result = productExceptSelfBrute(nums);
    for (int x : result) cout << x << " ";  // 24 12 8 6
    return 0;
}
Time Complexity: O(n²)
Space Complexity: O(1) excluding output

Solution – Optimized (Prefix and Suffix Products)
cpp
#include <iostream>
#include <vector>
using namespace std;

vector<int> productExceptSelf(vector<int>& nums) {
    int n = nums.size();
    vector<int> result(n, 1);
    
    // First pass: left products
    int leftProduct = 1;
    for (int i = 0; i < n; i++) {
        result[i] = leftProduct;
        leftProduct *= nums[i];
    }
    
    // Second pass: right products
    int rightProduct = 1;
    for (int i = n - 1; i >= 0; i--) {
        result[i] *= rightProduct;
        rightProduct *= nums[i];
    }
    
    return result;
}

int main() {
    vector<int> nums = {1, 2, 3, 4};
    auto result = productExceptSelf(nums);
    for (int x : result) cout << x << " ";  // 24 12 8 6
    
    cout << endl;
    
    // Dry run for [1,2,3,4]:
    // Left pass: result = [1,1,2,6]
    // Right pass: result = [1*24=24, 1*12=12, 2*4=8, 6*1=6]
    
    return 0;
}
Time Complexity: O(n) – two passes
Space Complexity: O(1) excluding output

Explanation: answer[i] = (product of elements left of i) × (product of elements right of i). Compute left products in first pass, multiply by right products in second pass.

Question 5: Find All Duplicates in an Array
LeetCode 442 | Difficulty: Medium

Problem Statement
Given an integer array nums of length n where each integer is between 1 and n, some elements appear twice. Find all elements that appear twice. Do it in O(n) time and O(1) extra space.

Example Cases

Input	Output
[4,3,2,7,8,2,3,1]	[2,3]
[1,1,2]	[1]
Constraints

n == nums.length

1 ≤ n ≤ 10⁵

1 ≤ nums[i] ≤ n

Solution – Brute Force
cpp
#include <iostream>
#include <vector>
#include <unordered_set>
using namespace std;

vector<int> findDuplicatesBrute(vector<int>& nums) {
    unordered_set<int> seen;
    vector<int> result;
    
    for (int num : nums) {
        if (seen.find(num) != seen.end()) {
            result.push_back(num);
        } else {
            seen.insert(num);
        }
    }
    
    return result;
}

int main() {
    vector<int> nums = {4, 3, 2, 7, 8, 2, 3, 1};
    auto result = findDuplicatesBrute(nums);
    for (int x : result) cout << x << " ";  // 2 3
    return 0;
}
Time Complexity: O(n)
Space Complexity: O(n) – violates O(1) requirement

Solution – Optimized (Marking with Negatives)
cpp
#include <iostream>
#include <vector>
#include <cmath>
using namespace std;

vector<int> findDuplicates(vector<int>& nums) {
    vector<int> result;
    
    for (int i = 0; i < nums.size(); i++) {
        int index = abs(nums[i]) - 1;
        
        if (nums[index] < 0) {
            // Already marked negative → this is a duplicate
            result.push_back(abs(nums[i]));
        } else {
            // Mark as visited by making negative
            nums[index] = -nums[index];
        }
    }
    
    return result;
}

int main() {
    vector<int> nums = {4, 3, 2, 7, 8, 2, 3, 1};
    auto result = findDuplicates(nums);
    for (int x : result) cout << x << " ";  // 2 3
    
    cout << endl;
    
    // Dry run for first few steps:
    // i=0: num=4, index=3, nums[3]=7 (positive) → set to -7
    // i=1: num=3, index=2, nums[2]=2 (positive) → set to -2
    // i=2: num=2, index=1, nums[1]=3 (positive) → set to -3
    // i=3: num=7, index=6, nums[6]=1 (positive) → set to -1
    // i=4: num=8, index=7, nums[7]=1 (positive) → set to -1
    // i=5: num=2, index=1, nums[1]=-3 (negative) → duplicate! add 2
    // i=6: num=3, index=2, nums[2]=-2 (negative) → duplicate! add 3
    
    return 0;
}
Time Complexity: O(n) – single pass
Space Complexity: O(1) excluding output

Explanation: Since numbers are between 1 and n, use array indices as markers. When seeing a number, mark its corresponding index as negative. 
If already negative, the number is a duplicate.