#include <iostream>
using namespace std;

class DynamicArray {
private:
    int* data_;
    int size_;
    
public:
    // Constructor - allocate memory
    DynamicArray(int size) : size_(size) {
        data_ = new int[size_];
        cout << "Allocated array of size " << size_ << endl;
