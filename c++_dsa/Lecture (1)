Chapter 6: Encapsulation
Protecting Data and Controlling Access
Encapsulation is the principle of hiding internal details and exposing only what is necessary. It prevents external code from putting an object into an invalid state.

6.1 Public vs Private vs Protected
C++ provides three access specifiers to control visibility of class members.

Specifier	Access from outside class	Access from derived classes	Access from within class
public	Yes	Yes	Yes
private	No	No	Yes
protected	No	Yes	Yes
cpp
class AccessDemo {
public:
    int publicVar;      // Accessible anywhere
    
private:
    int privateVar;     // Accessible only within AccessDemo
    
protected:
    int protectedVar;   // Accessible within AccessDemo and derived classes
    
public:
    void setPrivate(int value) {
        privateVar = value;  // OK - inside the class
    }
    
    int getPrivate() const {
        return privateVar;   // OK - inside the class
    }
};

class Derived : public AccessDemo {
public:
    void showAccess() {
        publicVar = 1;       // OK - public is accessible
        protectedVar = 2;    // OK - protected is accessible in derived class
        // privateVar = 3;   // ERROR - private not accessible in derived class
    }
};

int main() {
    AccessDemo obj;
    obj.publicVar = 10;      // OK - public member
    
    // obj.privateVar = 20;  // ERROR - private member
    // obj.protectedVar = 30;// ERROR - protected member (not in derived class)
    
    obj.setPrivate(20);      // OK - public member function accesses private
    
    return 0;
}
Best practice: Default to private for member variables. Use public only for the interface. Use protected only when inheritance specifically requires it.

6.2 Getters and Setters (Detailed)
Getters provide read access to private data. Setters provide controlled write access.

cpp
#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    string name_;
    double price_;
    int quantity_;
    
public:
    Product(string name, double price, int quantity)
        : name_(name), price_(price), quantity_(quantity) {}
    
    // Getters - const, no modification
    string getName() const { return name_; }
    double getPrice() const { return price_; }
    int getQuantity() const { return quantity_; }
    
    // Setters with validation
    void setPrice(double newPrice) {
        if (newPrice >= 0) {
            price_ = newPrice;
        } else {
            cout << "Error: Price cannot be negative" << endl;
        }
    }
    
    void setQuantity(int newQuantity) {
        if (newQuantity >= 0) {
            quantity_ = newQuantity;
        } else {
            cout << "Error: Quantity cannot be negative" << endl;
        }
    }
    
    // Business logic
    double totalValue() const {
        return price_ * quantity_;
    }
};

int main() {
    Product p("Laptop", 999.99, 10);
    
    // Read via getters
    cout << p.getName() << endl;     // Laptop
    cout << p.getPrice() << endl;    // 999.99
    cout << p.getQuantity() << endl; // 10
    cout << p.totalValue() << endl;  // 9999.9
    
    // Modify via setters (validation applied)
    p.setPrice(1099.99);
    p.setQuantity(5);
    
    cout << p.totalValue() << endl;  // 5499.95
    
    p.setPrice(-100);  // Error: Price cannot be negative
    p.setQuantity(-5); // Error: Quantity cannot be negative
    
    return 0;
}
When to use getters/setters vs direct access:

Scenario	Recommendation
Simple data container (no validation)	Use public members or a struct
Data needs validation	Use setters with validation
Derived/computed values	Use getters only (no setter)
Internal implementation detail	Keep private, no getter/setter
6.3 Accessor vs Mutator Naming Conventions
Several naming conventions exist for getters and setters.

Convention	Getter Example	Setter Example
get/set prefix	getName()	setName()
No prefix (same as variable)	name()	setName()
Java style	getName()	setName()
Direct member access (no getter/setter for public)	obj.name	obj.name = value
This book uses the get/set prefix for clarity, especially for beginners.

cpp
class Student {
private:
    string name_;
    int grade_;
    
public:
    // Getters with 'get' prefix
    string getName() const { return name_; }
    int getGrade() const { return grade_; }
    
    // Setters with 'set' prefix
    void setName(string name) { name_ = name; }
    void setGrade(int grade) { grade_ = grade; }
};
For boolean getters, is or has prefix is common:

cpp
class Account {
private:
    bool active_;
    
public:
    bool isActive() const { return active_; }
    // Not: getActive()
};
6.4 Friend Functions and Classes
The friend keyword allows a function or another class to access private and protected members. Friendship breaks encapsulation and should be used sparingly.

cpp
#include <iostream>
using namespace std;

class BankAccount {
private:
    double balance_;
    
public:
    BankAccount(double initial) : balance_(initial) {}
    
    // Declare a non-member function as a friend
    friend void inspectAccount(const BankAccount& account);
    
    // Declare another class as a friend
    friend class Auditor;
};

// Friend function - can access private members
void inspectAccount(const BankAccount& account) {
    cout << "Balance: " << account.balance_ << endl;  // OK - friend
}

class Auditor {
public:
    void audit(const BankAccount& account) {
        cout << "Auditing: " << account.balance_ << endl;  // OK - friend
    }
};

int main() {
    BankAccount acc(1000);
    inspectAccount(acc);  // Balance: 1000
    
    Auditor a;
    a.audit(acc);         // Auditing: 1000
    
    return 0;
}
When friend is appropriate:

Operator overloading (especially << and >>)

Two classes that are tightly coupled (like a container and its iterator)

Testing frameworks that need access to private state

When friend is NOT appropriate:

To avoid writing a proper getter/setter

When the friendship is not documented

When the friend class could use the public interface instead

Warning: Overuse of friend creates tight coupling and makes code harder to maintain.

6.5 Chapter Summary
public members are accessible anywhere; private members only within the class

Getters provide read access to private data and should be const

Setters provide controlled write access with optional validation

Naming conventions include get/set prefix, no prefix, or direct public members

friend functions and classes bypass encapsulation – use sparingly

Encapsulation protects class invariants – conditions that must always be true

6.6 Check Your Understanding
Question 1: What is the difference between private and protected?

Answer: private members are not accessible in derived classes. protected members are accessible in derived classes.

Question 2: Why should member variables typically be private?

Answer: To control access and validation, maintain invariants, and allow changing implementation without affecting users of the class.

Question 3: What does const mean after a member function declaration?

Answer: The function promises not to modify any member variables of the object.

Question 4: What is the syntax to declare a non-member function as a friend of a class?

Answer: friend returnType functionName(parameters); inside the class definition.

Question 5: When is a setter necessary instead of a public member variable?

Answer: When validation is required, when setting triggers side effects, or when the internal representation differs from the external interface.

6.7 Hands-on Exercises
Exercise 1: Create a class BankAccount with private balance_. Write getters and setters where appropriate. The setter for balance should only allow non-negative values. Add a transfer function that is a friend to both source and target accounts.

Solution:

cpp
#include <iostream>
#include <string>
using namespace std;

class BankAccount {
private:
    string owner_;
    double balance_;
    
public:
    BankAccount(string owner, double initial) 
        : owner_(owner), balance_(initial) {}
    
    string getOwner() const { return owner_; }
    double getBalance() const { return balance_; }
    
    void deposit(double amount) {
        if (amount > 0) {
            balance_ = balance_ + amount;
        }
    }
    
    bool withdraw(double amount) {
        if (amount > 0 && amount <= balance_) {
            balance_ = balance_ - amount;
            return true;
        }
        return false;
    }
    
    friend void transfer(BankAccount& from, BankAccount& to, double amount);
};

// Friend function can access private members of both accounts
void transfer(BankAccount& from, BankAccount& to, double amount) {
    if (amount > 0 && amount <= from.balance_) {
        from.balance_ = from.balance_ - amount;
        to.balance_ = to.balance_ + amount;
        cout << "Transferred " << amount << " from " << from.owner_;
        cout << " to " << to.owner_ << endl;
    } else {
        cout << "Transfer failed" << endl;
    }
}

int main() {
    BankAccount alice("Alice", 100);
    BankAccount bob("Bob", 50);
    
    cout << alice.getOwner() << ": $" << alice.getBalance() << endl;  // Alice: $100
    cout << bob.getOwner() << ": $" << bob.getBalance() << endl;      // Bob: $50
    
    transfer(alice, bob, 30);
    
    cout << alice.getOwner() << ": $" << alice.getBalance() << endl;  // Alice: $70
    cout << bob.getOwner() << ": $" << bob.getBalance() << endl;      // Bob: $80
    
    return 0;
}
Exercise 2: Create a class Thermostat with private temperature_ (Celsius). Add getters and setters. The setter should validate that temperature stays between 10 and 30 degrees. Add a getter isComfortable() that returns true if temperature is between 18 and 25.

Solution:

cpp
#include <iostream>
using namespace std;

class Thermostat {
private:
    double temperature_;
    
public:
    Thermostat(double initial) : temperature_(initial) {}
    
    double getTemperature() const {
        return temperature_;
    }
    
    void setTemperature(double newTemp) {
        if (newTemp >= 10.0 && newTemp <= 30.0) {
            temperature_ = newTemp;
        } else {
            cout << "Temperature " << newTemp << " out of range (10-30). Setting not changed." << endl;
        }
    }
    
    bool isComfortable() const {
        return temperature_ >= 18.0 && temperature_ <= 25.0;
    }
};

int main() {
    Thermostat t(22);
    cout << t.isComfortable() << endl;     // 1 (true)
    
    t.setTemperature(28);
    cout << t.isComfortable() << endl;     // 0 (false)
    
    t.setTemperature(20);
    cout << t.isComfortable() << endl;     // 1 (true)
    
    t.setTemperature(35);  // Error message
    cout << t.getTemperature() << endl;    // 20 (unchanged)
    
    return 0;
}
Exercise 3: The following code fails to compile. Identify why and fix it.

cpp
class Rectangle {
private:
    double width;
    double height;
    
public:
    Rectangle(double w, double h) : width(w), height(h) {}
};

int main() {
    Rectangle r1(5, 3);
    cout << r1.width << " x " << r1.height << endl;
    return 0;
}
Solution: The member variables width and height are private, so they cannot be accessed directly in main(). Add getters or make them public.

Fixed code:

cpp
#include <iostream>
using namespace std;

class Rectangle {
private:
    double width_;
    double height_;
    
public:
    Rectangle(double w, double h) : width_(w), height_(h) {}
    
    double getWidth() const { return width_; }
    double getHeight() const { return height_; }
    double area() const { return width_ * height_; }
};

int main() {
    Rectangle r1(5, 3);
    cout << r1.getWidth() << " x " << r1.getHeight() << " = ";
    cout << r1.area() << endl;  // 5 x 3 = 15
    return 0;
}