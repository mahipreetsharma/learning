1.8 Hands-on Exercises
Exercise 1: Add a transfer member function to the BankAccount class. 
The function should take another BankAccount object (by reference) and an amount. 
It should withdraw from the current account and deposit into the other account.

Solution:

cpp
#include <iostream>
#include <string>
using namespace std;

class BankAccount {
private:
    string owner;
    double balance;
    
public:
    BankAccount(string accountOwner) {
        owner = accountOwner;
        balance = 0.0;
    }
    
    void deposit(double amount) {
        balance = balance + amount;
    }
    
    bool withdraw(double amount) {
        if (amount <= balance) {
            balance = balance - amount;
            return true;
        }
        return false;
    }
    
    double getBalance() {
        return balance;
    }
    
    string getOwner() {
        return owner;
    }
    
    void transfer(BankAccount& target, double amount) {
        if (withdraw(amount)) {
            target.deposit(amount);
            cout << "Transferred " << amount << " from " << owner;
            cout << " to " << target.getOwner() << endl;
        } else {
            cout << "Transfer failed: insufficient funds in " << owner << endl;
        }
    }
};

int main() {
    BankAccount alice("Alice");
    BankAccount bob("Bob");
    
    alice.deposit(100);
    alice.transfer(bob, 40);
    
    cout << "Alice balance: " << alice.getBalance() << endl;  // 60
    cout << "Bob balance: " << bob.getBalance() << endl;      // 40
    
    return 0;
}
Output:

text
Transferred 40 from Alice to Bob
Alice balance: 60
Bob balance: 40
Exercise 2: Create a class Rectangle with private member 
variables width and height. Add a constructor that takes both values. 
Add member functions area(), perimeter(), and isSquare() 
(returns true if width equals height).

Solution:

cpp
#include <iostream>
using namespace std;

class Rectangle {
private:
    double width;
    double height;
    
public:
    Rectangle(double w, double h) {
        width = w;
        height = h;
    }
    
    double area() {
        return width * height;
    }
    
    double perimeter() {
        return 2 * (width + height);
    }
    
    bool isSquare() {
        return width == height;
    }
};

int main() {
    Rectangle rect1(5, 3);
    Rectangle rect2(4, 4);
    
    cout << "Rect1 area: " << rect1.area() << endl;           // 15
    cout << "Rect1 perimeter: " << rect1.perimeter() << endl; // 16
    cout << "Rect1 is square: " << rect1.isSquare() << endl;  // 0 (false)
    
    cout << "Rect2 area: " << rect2.area() << endl;           // 16
    cout << "Rect2 perimeter: " << rect2.perimeter() << endl; // 16
    cout << "Rect2 is square: " << rect2.isSquare() << endl;  // 1 (true)
    
